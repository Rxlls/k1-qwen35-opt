# 统一换行符为 LF，避免 Windows 下提交的脚本在 Linux 上执行失败
# （症状：bash: $'\r': command not found）

* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.patch text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.docx  binary
*.zip   binary
*.gz    binary
*.gguf  binary
